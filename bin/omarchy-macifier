#!/bin/bash
# Macifier — opt-in, reversible Mac-affinity mode for Omarchy.
#
# Prototype (Phase 0). Ships nothing into /usr/share/omarchy; everything it
# writes lives under $HOME and is removed again by `off`.
#
#   omarchy-macifier on|off|toggle|status

set -euo pipefail

TEMPLATE="$HOME/.local/share/macifier/macifier.lua"
FLAG_HYPR="$HOME/.local/state/omarchy/toggles/hypr/macifier.lua"

is_on() { [[ -f $FLAG_HYPR ]]; }

reload() { hyprctl reload >/dev/null 2>&1 || true; }

on() {
  [[ -f $TEMPLATE ]] || { echo "missing template: $TEMPLATE" >&2; exit 1; }
  mkdir -p "$(dirname "$FLAG_HYPR")"
  cp "$TEMPLATE" "$FLAG_HYPR"
  omarchy toggle macifier on          # marker other code can query
  reload
  echo "macifier: on"
}

off() {
  rm -f "$FLAG_HYPR"
  omarchy toggle macifier off
  reload
  echo "macifier: off"
}

case "${1:-toggle}" in
  on)     on ;;
  off)    off ;;
  toggle) if is_on; then off; else on; fi ;;
  status) if is_on; then echo "on"; else echo "off"; fi ;;
  *)      echo "Usage: omarchy-macifier on|off|toggle|status" >&2; exit 1 ;;
esac
