#!/bin/bash
# Macifier — opt-in, reversible Mac-affinity mode for Omarchy.
#
#   omarchy-macifier option <name> [on|off|toggle]   one option
#   omarchy-macifier preset <minimal|full|off>       a named set
#   omarchy-macifier status [--json]                 what is on
#   omarchy-macifier list                            available options
#   omarchy-macifier dock <id> [add|remove|toggle]   pin or unpin an app
#   omarchy-macifier dock placeholders [list|on|off] the "not built yet" tiles
#   omarchy-macifier dock trash [open|empty|on|off]  the system trash tile
#   omarchy-macifier panel [open|keys|dock]          summon the panel
#
# Every option is independent. Presets are just shorthand for a group of them,
# so "minimal" and "full" never become states you can be stuck in — turn any
# single option off afterwards and the rest stay put.

set -euo pipefail

SHARE="$HOME/.local/share/macifier"
HYPR_DIR="$HOME/.local/state/omarchy/toggles/hypr"
STATE="$HOME/.local/state/macifier"

# name|kind|description
# kind: hypr = a Lua fragment in the toggle dir
#       bar  = an Omarchy bar widget (edits shell.json, needs revert state)
#       root = a system file outside $HOME (needs privilege; see priv())
OPTIONS=(
  "scroll|hypr|Trackpad scrolls in the macOS direction"
  "capslock|hypr|Caps Lock works as Caps Lock, not Compose"
  "mediakeys|root|F1-F12 do brightness/volume directly, Fn for F-keys"
  "windowtitle|bar|Focused window's name shown in the bar"
  "cmdkeys|keys|Command-key shortcuts (configurable key by key)"
  "appswitcher|switcher|Command+Tab switches apps, not workspaces"
  "dock|dock|Auto-hiding dock of favourite apps along the bottom"
  "launchpad|launchpad|Full-screen grid of every installed application"
  "gestures|hypr|Trackpad gestures: spaces, Mission Control, Expose, Launchpad"
)

DOCKSET="$STATE/dock"

# Seeded from what is actually installed rather than a fixed list, so the dock
# is useful on first reveal instead of empty.
dock_defaults() {
  local want=(chromium org.gnome.Nautilus foot Discord omawrite)
  local w
  for w in "${want[@]}"; do
    if [[ -f "/usr/share/applications/$w.desktop" || -f "$HOME/.local/share/applications/$w.desktop" ]]; then
      echo "$w"
    fi
  done
}

dock_pinned() { [[ -f $DOCKSET ]] && cat "$DOCKSET" || true; }
dock_is_pinned() { [[ -f $DOCKSET ]] && grep -qx "$1" "$DOCKSET"; }

# Mac dock staples we have not built yet, shown as grey barred tiles so the gap
# is visible rather than merely absent. Off is a file, so the default is on.
DOCKPH="$SHARE/dock-placeholders.json"
DOCKPH_OFF="$STATE/dock.placeholders.off"

dock_placeholders_on() { [[ ! -f $DOCKPH_OFF ]]; }

dock_placeholders_set() {
  mkdir -p "$STATE"
  case "${1:-toggle}" in
    on)     rm -f "$DOCKPH_OFF" ;;
    off)    touch "$DOCKPH_OFF" ;;
    toggle) if dock_placeholders_on; then touch "$DOCKPH_OFF"; else rm -f "$DOCKPH_OFF"; fi ;;
    *) echo "usage: omarchy-macifier dock placeholders [on|off|toggle]" >&2; exit 1 ;;
  esac
}

# Hidden reads as an empty list rather than a flag the dock has to interpret —
# one shape of answer, so the QML has no second code path to get wrong.
dock_placeholders_json() {
  if ! dock_placeholders_on || [[ ! -f $DOCKPH ]]; then
    echo '{"placeholders":[]}'
    return
  fi
  cat "$DOCKPH"
}

# --- trash -------------------------------------------------------------------
# Linux already has a trash and Omarchy does not touch it: the freedesktop.org
# spec puts the file in ~/.local/share/Trash/files and a .trashinfo record
# beside it holding the original path, and every other mount gets its own
# .Trash-$UID at its root. `gio` speaks all of that, so the dock tile is a view
# onto the system trash rather than a trash of our own. Nothing here changes
# how Omarchy or the file manager behaves.
TRASH_OFF="$STATE/dock.trash.off"

dock_trash_shown() { [[ ! -f $TRASH_OFF ]]; }
dock_trash_available() { command -v gio >/dev/null 2>&1; }

dock_trash_set() {
  mkdir -p "$STATE"
  case "${1:-toggle}" in
    on)     rm -f "$TRASH_OFF" ;;
    off)    touch "$TRASH_OFF" ;;
    toggle) if dock_trash_shown; then touch "$TRASH_OFF"; else rm -f "$TRASH_OFF"; fi ;;
    *) echo "usage: omarchy-macifier dock trash [status|open|empty|on|off|toggle]" >&2; exit 1 ;;
  esac
}

# Counted through gio rather than by listing ~/.local/share/Trash/files, so
# items trashed on another filesystem are counted too — they live in a
# .Trash-$UID on that mount, not in home.
dock_trash_count() {
  dock_trash_available || { echo 0; return; }
  gio trash --list 2>/dev/null | grep -c . || true
}

dock_trash_status_json() {
  printf '{"shown":%s,"available":%s,"count":%s}\n' \
    "$(dock_trash_shown && echo true || echo false)" \
    "$(dock_trash_available && echo true || echo false)" \
    "$(dock_trash_count)"
}

# `dock <id>` with no verb pins by default, which makes every word a potential
# app id — so a subcommand this version does not know becomes a pinned app
# called "placeholders". That is exactly what an older CLI did when a newer
# dock polled it. Reserve the verbs on this side, and have the dock call the
# explicit `placeholders list` form, which every older version rejects without
# writing anything.
DOCK_RESERVED=(apps list reset placeholders trash)

dock_set() {
  local id="$1" action="${2:-toggle}" r
  for r in "${DOCK_RESERVED[@]}"; do
    [[ $id == "$r" ]] && { echo "'$id' is a dock subcommand, not an app id" >&2; exit 1; }
  done
  mkdir -p "$STATE"; touch "$DOCKSET"
  case "$action" in
    add)    dock_is_pinned "$id" || echo "$id" >> "$DOCKSET" ;;
    remove) grep -vx "$id" "$DOCKSET" > "$DOCKSET.tmp" 2>/dev/null || true; mv "$DOCKSET.tmp" "$DOCKSET" ;;
    toggle) if dock_is_pinned "$id"; then dock_set "$id" remove; else dock_set "$id" add; fi ;;
    *) echo "usage: omarchy-macifier dock <id> [add|remove|toggle]" >&2; exit 1 ;;
  esac
}

# Every installed application, marked with whether it is on the dock. Feeds the
# editor in the panel.
dock_apps_json() {
  python3 - "$DOCKSET" <<'PYEOF'
import os, sys, glob, json
pinned = []
if len(sys.argv) > 1 and os.path.exists(sys.argv[1]):
    pinned = [l.strip() for l in open(sys.argv[1]) if l.strip()]
apps = {}
for d in ("/usr/share/applications", os.path.expanduser("~/.local/share/applications")):
    for f in glob.glob(os.path.join(d, "*.desktop")):
        entry_id = os.path.basename(f)[:-8]
        name, nodisplay, hidden = entry_id, False, False
        try:
            in_entry = False
            for line in open(f, encoding="utf-8", errors="ignore"):
                line = line.strip()
                if line.startswith("["):
                    in_entry = line == "[Desktop Entry]"
                    continue
                if not in_entry:
                    continue
                if line.startswith("Name=") and name == entry_id:
                    name = line[5:]
                elif line.startswith("NoDisplay="):
                    nodisplay = line.split("=", 1)[1].strip().lower() == "true"
                elif line.startswith("Hidden="):
                    hidden = line.split("=", 1)[1].strip().lower() == "true"
        except Exception:
            pass
        if nodisplay or hidden:
            continue
        apps[entry_id] = name
rows = [{"id": k, "name": v, "pinned": k in pinned} for k, v in apps.items()]
# Pinned first, in dock order, then everything else alphabetically.
rows.sort(key=lambda r: (0, pinned.index(r["id"])) if r["pinned"] else (1, r["name"].lower()))
print(json.dumps({"apps": rows}))
PYEOF
}

MINIMAL=(scroll capslock mediakeys)
FULL=(scroll capslock mediakeys windowtitle cmdkeys appswitcher dock launchpad gestures)

# --- the Command-key table ---------------------------------------------------
# letter|mac label|group|displaced Omarchy binding|Lua dispatcher for it
#
# group "free"  Omarchy leaves the letter unbound, so claiming it costs nothing.
# group "wm"    the letter holds a window-management binding, which moves to
#               CTRL+ALT + the same letter. Enabling one of these takes
#               something away, so they are off in the minimal set.
KEYS=(
  "A|Select all|free||"
  "B|Bold|free||"
  "D|Duplicate / bookmark|free||"
  "E|Search / edit|free||"
  "I|Italic|free||"
  "N|New|free||"
  "R|Reload|free||"
  "U|Underline|free||"
  "Y|Redo (Windows-style)|free||"
  "Z|Undo|free||"
  "Q|Close window|special||"
  "F|Find|wm|Full screen|hl.dsp.window.fullscreen({ mode = \"fullscreen\" })"
  "S|Save|wm|Toggle scratchpad|hl.dsp.workspace.toggle_special(\"scratchpad\")"
  "T|New tab|wm|Toggle window floating/tiling|hl.dsp.window.float({ action = \"toggle\" })"
  "P|Print|wm|Pseudo window|hl.dsp.window.pseudo()"
  "G|Find next|wm|Toggle window grouping|hl.dsp.group.toggle()"
  "L|Location bar|wm|Toggle workspace layout|\"omarchy-hyprland-workspace-layout-toggle\""
  "K|Insert link|wm|Keybindings|\"omarchy-menu-keybindings\""
  "O|Open|wm|Pop window out (float & pin)|\"omarchy-hyprland-window-pop\""
)

KEYSET="$STATE/keyset"

key_field() { local l="$1" i="$2" e; for e in "${KEYS[@]}"; do [[ ${e%%|*} == "$l" ]] && { IFS='|' read -r -a f <<<"$e"; echo "${f[$i]-}"; return; }; done; }
key_letters() { local e; for e in "${KEYS[@]}"; do echo "${e%%|*}"; done; }
key_group()   { key_field "$1" 2; }

# Minimal = everything that costs nothing. Full = every letter.
keys_preset_set() {
  case "$1" in
    minimal)
      local l
      while read -r l; do
        if [[ $(key_group "$l") != wm ]]; then echo "$l"; fi
      done < <(key_letters)
      ;;
    full)    key_letters ;;
    none)    : ;;
  esac
}

key_enabled() { [[ -f $KEYSET ]] && grep -qx "$1" "$KEYSET"; }

keys_current_preset() {
  local now min full
  now="$(sort "$KEYSET" 2>/dev/null | tr '\n' ' ')"
  [[ -z ${now// } ]] && { echo none; return; }
  min="$(keys_preset_set minimal | sort | tr '\n' ' ')"
  full="$(keys_preset_set full | sort | tr '\n' ' ')"
  [[ $now == "$min" ]] && { echo minimal; return; }
  [[ $now == "$full" ]] && { echo full; return; }
  echo custom
}

FNMODE_PARAM="/sys/module/hid_apple/parameters/fnmode"
FNMODE_TMPFILE="/etc/tmpfiles.d/macifier-fnmode.conf"

# An option can be inapplicable rather than merely off — mediakeys means
# nothing without an Apple keyboard. Reported separately so the panel can grey
# the switch and say why, instead of offering a control that would do nothing.
opt_available() {
  case "$1" in
    mediakeys) [[ -e $FNMODE_PARAM ]] ;;
    *) true ;;
  esac
}

# Root is needed only by `root`-kind options. A terminal gets sudo, which can
# explain itself and reuse a cached credential; a panel click has nowhere to
# type a password, so it gets pkexec's dialog.
#
# TODO: this is the first option to need privilege and it will not be the last.
# A general pattern (a narrow NOPASSWD sudoers entry, as Omarchy already ships
# for asdcontrol and omarchy-dns) is likely the right answer once there are
# two or three of these. Revisit before adding the next one.
priv() {
  if [[ -t 0 ]]; then sudo "$@"; else pkexec "$@"; fi
}

opt_kind() { local n="$1"; for o in "${OPTIONS[@]}"; do [[ ${o%%|*} == "$n" ]] && { IFS='|' read -r _ k _ <<<"$o"; echo "$k"; return; }; done; return 1; }
opt_desc() { local n="$1"; for o in "${OPTIONS[@]}"; do [[ ${o%%|*} == "$n" ]] && { IFS='|' read -r _ _ d <<<"$o"; echo "$d"; return; }; done; }
opt_names() { for o in "${OPTIONS[@]}"; do echo "${o%%|*}"; done; }

reload() { hyprctl reload >/dev/null 2>&1 || true; }

is_on() {
  local n="$1"
  case "$(opt_kind "$n")" in
    hypr) [[ -f "$HYPR_DIR/macifier-$n.lua" ]] ;;
    bar)  [[ -f "$STATE/$n" ]] ;;
    root) [[ -f $FNMODE_TMPFILE ]] ;;
    keys) [[ -s $KEYSET ]] ;;
    switcher) [[ -f "$HYPR_DIR/macifier-appswitcher.lua" ]] ;;
    dock) [[ -f "$STATE/dock.enabled" ]] ;;
    launchpad) [[ -f "$HYPR_DIR/macifier-launchpad.lua" ]] ;;
  esac
}

# --- mediakeys ---------------------------------------------------------------
# hid_apple.fnmode: 1 = media keys primary (macOS), 2 = F-keys primary
# (Omarchy's default). The module is loaded from the initramfs, so modprobe.d
# would need mkinitcpio -P on every flip; a tmpfiles.d line re-applies the value
# on each boot instead, and removing the file is the whole revert.
mediakeys_on() {
  mkdir -p "$STATE"
  [[ -f "$STATE/mediakeys.prior" ]] || cat "$FNMODE_PARAM" > "$STATE/mediakeys.prior" 2>/dev/null || echo 2 > "$STATE/mediakeys.prior"
  priv /bin/sh -c "printf '%s\n' 'w $FNMODE_PARAM - - - - 1' > '$FNMODE_TMPFILE' && printf 1 > '$FNMODE_PARAM'"
}

mediakeys_off() {
  local prior; prior="$(cat "$STATE/mediakeys.prior" 2>/dev/null || echo 2)"
  priv /bin/sh -c "rm -f '$FNMODE_TMPFILE' && printf '%s' '$prior' > '$FNMODE_PARAM'"
  rm -f "$STATE/mediakeys.prior"
}

# --- the one option that touches state we do not own -------------------------
# The bar layout is the user's. Record whether the widget was already there so
# turning this option off restores what they had rather than what we assume.
bar_on() {
  mkdir -p "$STATE"
  if omarchy bar list 2>/dev/null | grep -q "omarchy.active-window" \
     || python3 - <<'PY'
import json,sys
try: d=json.load(open(__import__("os").path.expanduser("~/.config/omarchy/shell.json")))
except Exception: sys.exit(1)
w=[x.get("id") for s in d.get("bar",{}).get("layout",{}).values() for x in s]
sys.exit(0 if "omarchy.active-window" in w else 1)
PY
  then
    echo "preexisting" > "$STATE/windowtitle.prior"
  else
    echo "added" > "$STATE/windowtitle.prior"
    omarchy bar put omarchy.active-window --section left >/dev/null 2>&1 || true
  fi
  touch "$STATE/windowtitle"
}

bar_off() {
  if [[ "$(cat "$STATE/windowtitle.prior" 2>/dev/null)" == "added" ]]; then
    omarchy bar remove omarchy.active-window >/dev/null 2>&1 || true
  fi
  rm -f "$STATE/windowtitle" "$STATE/windowtitle.prior"
}

# --- generating the Command-key fragment -------------------------------------
# Unlike the other options this one is not a static file copy: what it binds
# depends on which letters are enabled, so the fragment is written fresh on
# every change. Same send technique as Omarchy's own clipboard bindings,
# including the down/up split that works around Hyprland leaving synthetic key
# state stuck (hyprwm/Hyprland#14099).
write_keys_fragment() {
  local out="$HYPR_DIR/macifier-cmdkeys.lua" l group mac omarchy disp
  mkdir -p "$HYPR_DIR"

  cat > "$out" <<'HEADER'
-- Generated by omarchy-macifier. Do not edit; edit the key set instead:
--   omarchy-macifier key <LETTER> on|off
--   omarchy-macifier key preset minimal|full|none
local function send_once(mods, key)
  return function()
    hl.dispatch(hl.dsp.send_key_state({ mods = mods, key = key, state = "down" }))
    hl.timer(function()
      hl.dispatch(hl.dsp.send_key_state({ mods = mods, key = key, state = "up" }))
    end, { timeout = 50, type = "oneshot" })
  end
end

local function active_window_is_terminal()
  local window = hl.get_active_window()
  if not window then return false end
  for _, tag in ipairs(window.tags or {}) do
    if tag:gsub("%*$", "") == "terminal" then return true end
  end
  return false
end

-- In a terminal these control codes mean something else and sending them would
-- be destructive: Ctrl+Z suspends, Ctrl+D closes the shell, Ctrl+A is
-- beginning-of-line. Do nothing rather than the wrong thing.
local function forward(key)
  return function()
    if active_window_is_terminal() then return end
    send_once("CTRL", key)()
  end
end
HEADER

  while read -r l; do
    key_enabled "$l" || continue
    group="$(key_group "$l")"
    mac="$(key_field "$l" 1)"
    omarchy="$(key_field "$l" 3)"
    disp="$(key_field "$l" 4)"

    case "$group" in
      special)
        # Cmd+Q. macOS quits the application; Hyprland has no concept of one,
        # so closing the window is the closest honest equivalent.
        printf 'o.bind("SUPER + Q", "Command+Q (%s)", hl.dsp.window.close())\n' "$mac" >> "$out"
        ;;
      wm)
        # Release the letter before claiming it, or both bindings fire, and
        # rehome the displaced binding on CTRL+ALT with the same letter.
        printf 'hl.unbind("SUPER + %s")\n' "$l" >> "$out"
        printf 'o.bind("CTRL + ALT + %s", "%s", %s)\n' "$l" "$omarchy" "$disp" >> "$out"
        printf 'o.bind("SUPER + %s", "Command+%s (%s)", forward("%s"))\n' "$l" "$l" "$mac" "$l" >> "$out"
        ;;
      *)
        printf 'o.bind("SUPER + %s", "Command+%s (%s)", forward("%s"))\n' "$l" "$l" "$mac" "$l" >> "$out"
        ;;
    esac
  done < <(key_letters)

  # Redo travels with undo.
  if key_enabled Z; then
    cat >> "$out" <<'REDO'
o.bind("SUPER + SHIFT + Z", "Command+Shift+Z (redo)", function()
  if active_window_is_terminal() then return end
  send_once("CTRL SHIFT", "Z")()
end)
REDO
  fi
}

keys_apply() {
  if [[ -s $KEYSET ]]; then write_keys_fragment; else rm -f "$HYPR_DIR/macifier-cmdkeys.lua"; fi
  reload
}

set_key() {
  local l="${1^^}" action="${2:-toggle}"
  key_group "$l" >/dev/null || { echo "unknown key: $l" >&2; exit 1; }
  mkdir -p "$STATE"; touch "$KEYSET"
  case "$action" in
    on)     key_enabled "$l" || echo "$l" >> "$KEYSET" ;;
    off)    grep -vx "$l" "$KEYSET" > "$KEYSET.tmp" 2>/dev/null || true; mv "$KEYSET.tmp" "$KEYSET" ;;
    toggle) if key_enabled "$l"; then set_key "$l" off; return; else set_key "$l" on; return; fi ;;
    *) echo "usage: omarchy-macifier key <LETTER> [on|off|toggle]" >&2; exit 1 ;;
  esac
  keys_apply
}

keys_preset() {
  mkdir -p "$STATE"
  keys_preset_set "${1:?preset required}" > "$KEYSET"
  keys_apply
  echo "keys: $1"
}

keys_status_json() {
  local l first=1
  printf '{"preset":"%s","keys":[' "$(keys_current_preset)"
  while read -r l; do
    [[ $first -eq 1 ]] || printf ','
    first=0
    printf '{"key":"%s","label":"%s","group":"%s","displaces":"%s","on":%s}' \
      "$l" "$(key_field "$l" 1)" "$(key_group "$l")" "$(key_field "$l" 3)" \
      "$(key_enabled "$l" && echo true || echo false)"
  done < <(key_letters)
  printf ']}\n'
}

keys_status_text() {
  local l
  echo "keys: $(keys_current_preset)"
  while read -r l; do
    printf '  [%s] Cmd+%-2s %-22s %s\n' \
      "$(key_enabled "$l" && echo x || echo ' ')" "$l" "$(key_field "$l" 1)" \
      "$([[ $(key_group "$l") == wm ]] && echo "(displaces: $(key_field "$l" 3))" || echo "")"
  done < <(key_letters)
}

option_on() {
  local n="$1"
  case "$(opt_kind "$n")" in
    hypr) mkdir -p "$HYPR_DIR"; cp "$SHARE/options/$n.lua" "$HYPR_DIR/macifier-$n.lua"; reload ;;
    bar)  bar_on ;;
    root) mediakeys_on ;;
    keys) [[ -s $KEYSET ]] || keys_preset_set minimal > "$KEYSET"; keys_apply ;;
    switcher)
      omarchy plugin enable local.macifier-switcher >/dev/null 2>&1 || true
      cp "$SHARE/options/appswitcher.lua" "$HYPR_DIR/macifier-appswitcher.lua"
      reload ;;
    dock)
      mkdir -p "$STATE" "$HYPR_DIR"
      [[ -s $DOCKSET ]] || dock_defaults > "$DOCKSET"
      touch "$STATE/dock.enabled"
      cp "$SHARE/options/dock.lua" "$HYPR_DIR/macifier-dock.lua"
      omarchy plugin enable local.macifier-dock >/dev/null 2>&1 || true
      reload ;;
    launchpad)
      omarchy plugin enable local.macifier-launchpad >/dev/null 2>&1 || true
      cp "$SHARE/options/launchpad.lua" "$HYPR_DIR/macifier-launchpad.lua"
      reload ;;
  esac
}

option_off() {
  local n="$1"
  case "$(opt_kind "$n")" in
    hypr) rm -f "$HYPR_DIR/macifier-$n.lua"; reload ;;
    bar)  bar_off ;;
    root) mediakeys_off ;;
    keys) : > "$KEYSET"; keys_apply ;;
    switcher)
      rm -f "$HYPR_DIR/macifier-appswitcher.lua"
      omarchy plugin disable local.macifier-switcher >/dev/null 2>&1 || true
      reload ;;
    dock)
      rm -f "$STATE/dock.enabled" "$HYPR_DIR/macifier-dock.lua"
      omarchy plugin disable local.macifier-dock >/dev/null 2>&1 || true
      reload ;;
    launchpad)
      rm -f "$HYPR_DIR/macifier-launchpad.lua"
      omarchy plugin disable local.macifier-launchpad >/dev/null 2>&1 || true
      reload ;;
  esac
}

set_option() {
  local n="$1" action="${2:-toggle}"
  opt_kind "$n" >/dev/null || { echo "unknown option: $n" >&2; exit 1; }
  opt_available "$n" || { echo "option not applicable on this hardware: $n" >&2; exit 1; }
  case "$action" in
    on)     option_on  "$n" ;;
    off)    option_off "$n" ;;
    toggle) if is_on "$n"; then option_off "$n"; else option_on "$n"; fi ;;
    *)      echo "usage: omarchy-macifier option <name> [on|off|toggle]" >&2; exit 1 ;;
  esac
}

apply_preset() {
  local preset="$1" wanted=()
  case "$preset" in
    minimal) wanted=("${MINIMAL[@]}") ;;
    full)    wanted=("${FULL[@]}") ;;
    off)     wanted=() ;;
    *) echo "unknown preset: $preset (minimal|full|off)" >&2; exit 1 ;;
  esac
  local n keep
  while read -r n; do
    keep=no
    for w in ${wanted[@]+"${wanted[@]}"}; do [[ $w == "$n" ]] && keep=yes; done
    opt_available "$n" || continue
    if [[ $keep == yes ]]; then is_on "$n" || option_on "$n"
    else is_on "$n" && option_off "$n" || true; fi
  done < <(opt_names)
  echo "macifier: $preset"
}

# Which preset, if any, the current set of options happens to match.
current_preset() {
  local on=() n
  while read -r n; do is_on "$n" && on+=("$n"); done < <(opt_names)
  [[ ${#on[@]} -eq 0 ]] && { echo off; return; }
  local joined="${on[*]}" want
  for preset in minimal full; do
    want=""
    local -n arr="${preset^^}"
    for w in "${arr[@]}"; do opt_available "$w" && want+="${want:+ }$w"; done
    [[ $joined == "$want" ]] && { echo "$preset"; return; }
  done
  echo custom
}

status_json() {
  local n first=1
  printf '{"preset":"%s","options":{' "$(current_preset)"
  while read -r n; do
    [[ $first -eq 1 ]] || printf ','
    first=0
    # The description travels with the state so the panel can render an option
    # it has no hand-written copy for. Without it a new option is invisible
    # there, which has now shipped twice.
    printf '"%s":{"on":%s,"available":%s,"description":"%s"}' "$n" \
      "$(is_on "$n" && echo true || echo false)" \
      "$(opt_available "$n" && echo true || echo false)" \
      "$(opt_desc "$n")"
  done < <(opt_names)
  printf '}}\n'
}

status_text() {
  local p; p="$(current_preset)"
  echo "macifier: $p"
  local n
  while read -r n; do
    if opt_available "$n"; then
      printf '  [%s] %-12s %s\n' "$(is_on "$n" && echo x || echo ' ')" "$n" "$(opt_desc "$n")"
    else
      printf '  [-] %-12s %s (not applicable on this hardware)\n' "$n" "$(opt_desc "$n")"
    fi
  done < <(opt_names)
}

case "${1:-status}" in
  option)  shift; set_option "${1:?option name required}" "${2:-toggle}" ;;
  dock)    shift
           case "${1:-}" in
             apps)   dock_apps_json ;;
             list)   dock_pinned ;;
             reset)  mkdir -p "$STATE"; dock_defaults > "$DOCKSET" ;;
             placeholders)
                     case "${2:-list}" in
                       list)          dock_placeholders_json ;;
                       on|off|toggle) dock_placeholders_set "$2" ;;
                       *) echo "usage: omarchy-macifier dock placeholders [list|on|off|toggle]" >&2; exit 1 ;;
                     esac ;;
             trash)
                     case "${2:-status}" in
                       status)        dock_trash_status_json ;;
                       count)         dock_trash_count ;;
                       open)          dock_trash_available && gio open trash:// >/dev/null 2>&1 || true ;;
                       empty)         dock_trash_available && gio trash --empty || true ;;
                       on|off|toggle) dock_trash_set "$2" ;;
                       *) echo "usage: omarchy-macifier dock trash [status|count|open|empty|on|off|toggle]" >&2; exit 1 ;;
                     esac ;;
             launchpad)
                     # The dock asks whether to draw the Launchpad tile. The
                     # explicit `status` verb is the same guard the trash and
                     # placeholder polls use: a CLI older than this reads a
                     # bare `dock launchpad` as "pin an app called launchpad".
                     case "${2:-status}" in
                       status) printf '{"on":%s}\n' "$(is_on launchpad && echo true || echo false)" ;;
                       *) echo "usage: omarchy-macifier dock launchpad [status]" >&2; exit 1 ;;
                     esac ;;
             "")     dock_pinned ;;
             *)      dock_set "$1" "${2:-toggle}" ;;
           esac ;;
  # The dock's context menu has no way to summon a panel by itself, and the
  # panel is the only place the full editor lives. One indirection, so the QML
  # keeps calling nothing but this script.
  panel)   shift
           omarchy-shell -q local.macifier "${1:-open}" ;;
  key)     shift
           case "${1:-}" in
             preset) keys_preset "${2:?minimal|full|none}" ;;
             status) if [[ "${2:-}" == "--json" ]]; then keys_status_json; else keys_status_text; fi ;;
             "")     keys_status_text ;;
             *)      set_key "$1" "${2:-toggle}" ;;
           esac ;;
  preset)  shift; apply_preset "${1:?preset required}" ;;
  status)  if [[ "${2:-}" == "--json" ]]; then status_json; else status_text; fi ;;
  list)    opt_names ;;
  # Back-compat with the Phase 0 interface.
  on)      apply_preset "${2:-minimal}" ;;
  off)     apply_preset off ;;
  toggle)  if [[ "$(current_preset)" == off ]]; then apply_preset minimal; else apply_preset off; fi ;;
  *) echo "usage: omarchy-macifier [option <name> [on|off|toggle] | preset <minimal|full|off> | status [--json] | list | dock ... | panel [open|keys|dock]]" >&2; exit 1 ;;
esac
